   ],
   "security": [
    {
     "bearerAuth": []
    }
   ],
   "paths": {
    "/uploads/member/document": {
     "post": {
      "tags": [
       ""
      ],
      "summary": "Upload Enrollment Documents",
      "description": "Uploads a document file for member enrollment. Supported file types are pdf, jpeg or png.",
      "operationId": "handleFileUpload",
      "parameters": [
       {
        "name": "documentId",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "documentType",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "qualifier",
        "in": "query",
        "required": false,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "clientMemberId",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "clientOrgName",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "productName",
        "in": "query",
        "required": true,
        "schema": {
         "type": "string"
        }
       }
      ],
      "requestBody": {
       "content": {
        "multipart/form-data": {
         "schema": {
          "type": "object",
          "properties": {
           "file": {
            "type": "string",
            "format": "binary"
           }
          },
          "required": [
           "file"
          ]
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "Ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/BaseResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       },
       "401": {
        "description": "Not authorized"
       },
       "404": {
        "description": "Not found",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       }
      },
      "security": [
       {
        "bearerAuth": []
       }
      ]
     }
    }
   },
   "components": {
    "schemas": {
     "ExceptionBaseResponse": {
      "type": "object",
      "properties": {
       "data": {
        "type": "object",
        "description": "null"
       },
       "exceptions": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/ResponseException"
        }
       }
      }
     },
     "ResponseException": {
      "type": "object",
      "properties": {
       "errorCode": {
        "type": "string",
        "description": "The GBL error code that is populated when the exceptionSource is SYSTEM"
       },
       "exceptionSource": {
        "type": "string",
        "description": "Characterizes the type of exception (JSON, SYSTEM, PARAMETER)"
       },
       "exceptionMessage": {
        "type": "string",
        "description": "Additional information about the exception"
       }
      }
     },
     "BaseResponse": {
      "type": "object",
      "properties": {
       "data": {
        "type": "object"
       },
       "exceptions": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/ResponseException"
        }
       }
      }
     }
    },
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
   }
  }
 }
]