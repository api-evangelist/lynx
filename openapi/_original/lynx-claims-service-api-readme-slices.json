    }
   ],
   "paths": {
    "/claims/member/claim": {
     "post": {
      "tags": [
       ""
      ],
      "summary": "Create a Claim",
      "description": "Allows a member to submit a Claim refund request for an out-of-pocket expense.",
      "operationId": "createClaim",
      "requestBody": {
       "content": {
        "multipart/form-data": {
         "schema": {
          "type": "object",
          "properties": {
           "data": {
            "$ref": "#/components/schemas/PostMemberClaimRequest"
           },
           "file": {
            "type": "string",
            "format": "binary",
            "description": "upload receipt"
           }
          },
          "required": [
           "data",
           "file"
          ]
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "Ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/PersistClaimsResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request.\n- GBL-199: Member account has no effective date\n- GBL-200: Claims not allowed for future dated effective date\n- GBL-304: Service date is past the allowed reimbursement period\n- GBL-280: Claims cannot be submitted against an ADVISORY account\n- GBL-294: Claim reimbursement via ACH requires an external account\n- GBL-240: Cannot process ACH reimbursement, no linked external account\n- GBL-338: Sum of claim detail amounts does not match claim amount\n- GBL-278: Expense date cannot be a future date\n- GBL-279: Invalid claim amount\n- GBL-239: Claim amount exceeds available balance\n- GBL-275: Unsupported file type\n- GBL-276: File size exceeds maximum limit\n- GBL-277: Unable to validate file, please try again\n",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       },
       "401": {
        "description": "Not authorized"
       },
       "404": {
        "description": "Not found",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "BaseMember": {
      "type": "object",
      "properties": {
       "clientMemberId": {
        "type": "string",
        "description": "Unique client-side identifier for the member",
        "example": "3f50436491"
       }
      },
      "required": [
       "clientMemberId"
      ]
     },
     "ClientOrgDto": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "description": "The name of the client organization",
        "example": "Health_Plan_ABC_Division"
       }
      },
      "required": [
       "name"
      ]
     },
     "Idempotency": {
      "type": "object",
      "properties": {
       "idempotencyKey": {
        "type": "string",
        "description": "Unique identifier that represents the operation",
        "example": "cf82639c-e3b6-4d51-9871-0e452a2b1566"
       }
      }
     },
     "ExceptionBaseResponse": {
      "type": "object",
      "properties": {
       "data": {
        "type": "object",
        "description": "null"
       },
       "exceptions": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/ResponseException"
        }
       }
      }
     },
     "ResponseException": {
      "type": "object",
      "properties": {
       "errorCode": {
        "type": "string",
        "description": "The GBL error code that is populated when the exceptionSource is SYSTEM"
       },
       "exceptionSource": {
        "type": "string",
        "description": "Characterizes the type of exception (JSON, SYSTEM, PARAMETER)"
       },
       "exceptionMessage": {
        "type": "string",
        "description": "Additional information about the exception"
       }
      }
     },
     "PersistClaimsResponse": {
      "type": "object",
      "properties": {
       "claimNumber": {
        "type": "string",
        "description": "The claim number",
        "example": "C-1234"
       },
       "clientMemberId": {
        "type": "string",
        "description": "Unique client-side identifier for the member",
        "example": "3f50436491"
       }
      },
      "required": [
       "claimNumber",
       "clientMemberId"
      ]
     },
     "BaseAddress": {
      "type": "object",
      "properties": {
       "line1": {
        "type": "string",
        "description": "The first line of the address",
        "example": 10
       },
       "line2": {
        "type": "string",
        "description": "The (optional) second line of the address",
        "example": "address line2"
       },
       "city": {
        "type": "string",
        "description": "Address city",
        "example": "Boston"
       },
       "stateProvince": {
        "type": "string",
        "description": "2-Character address state or province",
        "example": "MA"
       },
       "country": {
        "type": "string",
        "description": "Address country",
        "example": "US"
       },
       "postalCode": {
        "type": "string",
        "description": "Address zip code",
        "example": "02119"
       },
       "postalCodeExtension": {
        "type": "string",
        "description": "Address zip code extension",
        "example": "0123"
       }
      },
      "required": [
       "city",
       "country",
       "line1",
       "postalCode",
       "stateProvince"
      ]
     },
     "CreateClaimRequestData": {
      "type": "object",
      "properties": {
       "clientOrg": {
        "$ref": "#/components/schemas/ClientOrgDto"
       },
       "member": {
        "$ref": "#/components/schemas/BaseMember"
       },
       "memberAccount": {
        "$ref": "#/components/schemas/MemberAccountIdDto"
       },
       "memberBankAccount": {
        "$ref": "#/components/schemas/MemberBankAccountDto"
       },
       "merchantName": {
        "type": "string",
        "description": "Name of the merchant related to the claim",
        "example": "CVS Pharmacy, Boston MA"
       },
       "description": {
        "type": "string",
        "description": "The short description for the claim",
        "example": "Claim to reimburse the purchase of over the counter medicine"
       },
       "expenseDate": {
        "type": "string",
        "description": "The date when the expense was incurred",
        "example": "2024-01-01"
       },
       "claimAmount": {
        "type": "number",
        "description": "Total amount of the claim",
        "example": 50
       },
       "reimbursementType": {
        "type": "string",
        "description": "Method of payment for Reimbursement (CHECK/ACH)",
        "example": "CHECK"
       },
       "category": {
        "type": "string",
        "description": "The category for the Claim",
        "enum": [
         "OverTheCounter",
         "Wellness",
         "HealthyFood",
         "RentPayment",
         "UtilityPayment",
         "MortgagePayment",
         "Other",
         "FitnessFacility",
         "FitnessClass"
        ],
        "example": "OverTheCounter"
       },
       "items": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/MemberClaimItemDto"
        }
       },
       "address": {
        "$ref": "#/components/schemas/BaseAddress"
       },
       "serviceType": {
        "type": "string"
       }
      },
      "required": [
       "claimAmount",
       "clientOrg",
       "expenseDate",
       "member",
       "memberAccount",
       "reimbursementType"
      ]
     },
     "MemberAccountIdDto": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique identifier of the bank account",
        "example": "6ae73974-2bd1-0f0d-7316-bbfff8cdc91b"
       }
      },
      "required": [
       "id"
      ]
     },
     "MemberBankAccountDto": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "UUID of the Member's external bank account",
        "example": "2aa614ba-5590-4c16-bdd0-3f03964ee274"
       }
      },
      "required": [
       "id"
      ]
     },
     "MemberClaimItemDto": {
      "type": "object",
      "properties": {
       "itemDescription": {
        "type": "string",
        "description": "Description of the item or service. e.g. Tums, Teeth Cleaning",
        "example": "Tylenol"
       },
       "amount": {
        "type": "number",
        "description": "The cost of the individual item.",
        "example": 10
       }
      },
      "required": [
       "amount",
       "itemDescription"
      ]
     },
     "PostMemberClaimRequest": {
      "type": "object",
      "properties": {
       "data": {
        "$ref": "#/components/schemas/CreateClaimRequestData"
       },
       "idempotency": {
        "$ref": "#/components/schemas/Idempotency",
        "description": "Unique identifier that represents the operation",
        "example": "cf82639c-e3b6-4d51-9871-0e452a2b1566"
       }
      },
      "required": [
       "data",
       "idempotency"
      ]
     }
    },
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
   }
  }
