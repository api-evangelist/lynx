[
 {
  "page": "https://docs.lynx-fh.com/reference/updateclaim-1.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "CLAIMS SERVICE API",
    "description": "<Insert page description with key 'api.service.desc' within application.properties>",
    "termsOfService": "http://lynx-fh.com",
    "license": {
     "name": "LynxFH",
     "url": "http://lynx-fh.com"
    },
    "version": "<Insert version with key 'api.service.ver' within application.properties>"
   },
   "servers": [
    {
     "url": "https://sandbox.lynx-fh.co"
    }
   ],
   "security": [
    {
     "bearerAuth": []
    }
   ],
   "paths": {
    "/claims/member/claim": {
     "put": {
      "tags": [
       ""
      ],
      "summary": "Update a Claim",
      "description": "API that allows a client to update certain elements of an already existing member claim.\nOnly claims in the Submitted, PendingReview or NeedsReview statuses are able to be updated.\n",
      "operationId": "updateClaim",
      "requestBody": {
       "content": {
        "multipart/form-data": {
         "schema": {
          "type": "object",
          "properties": {
           "data": {
            "$ref": "#/components/schemas/PutMemberClaimRequest"
           },
           "file": {
            "type": "string",
            "format": "binary",
            "description": "upload receipt"
           }
          },
          "required": [
           "data"
          ]
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "Ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/PersistClaimsResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request.\n- GBL-250: Unable to update member claim in current status\n- GBL-338: Sum of claim detail amounts does not match claim amount\n- GBL-278: Expense date cannot be a future date\n- GBL-279: Invalid claim amount\n- GBL-239: Claim amount exceeds available balance\n- GBL-275: Unsupported file type\n- GBL-276: File size exceeds maximum limit\n- GBL-277: Unable to validate file, please try again\n",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       },
       "401": {
        "description": "Not authorized"
       },
       "404": {
        "description": "Not found",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "BaseMember": {
      "type": "object",
      "properties": {
       "clientMemberId": {
        "type": "string",
        "description": "Unique client-side identifier for the member",
        "example": "3f50436491"
       }
      },
      "required": [
       "clientMemberId"
      ]
     },
     "ClientOrgDto": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "description": "The name of the client organization",
        "example": "Health_Plan_ABC_Division"
       }
      },
      "required": [
       "name"
      ]
     },
     "Idempotency": {
      "type": "object",
      "properties": {
       "idempotencyKey": {
        "type": "string",
        "description": "Unique identifier that represents the operation",
        "example": "cf82639c-e3b6-4d51-9871-0e452a2b1566"
       }
      }
     },
     "MemberClaimUpdateDto": {
      "type": "object",
      "properties": {
       "itemDescription": {
        "type": "string",
        "description": "Description of the item or service. e.g. Tums, Teeth Cleaning",
        "example": "Tylenol"
       },
       "amount": {
        "type": "number",
        "description": "The cost of the individual item.",
        "example": 10
       },
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "ID of the existing item detail. Omit for new items.",
        "example": "2efe0ba7-9e84-44d1-9c5a-d9cb2d64bbee"
       }
      },
      "required": [
       "amount",
       "itemDescription"
      ]
     },
     "MemberClaimsData": {
      "type": "object",
      "properties": {
       "claimNumber": {
        "type": "string",
        "description": "The claim number",
        "example": "C-1234"
       },
       "member": {
        "$ref": "#/components/schemas/BaseMember"
       },
       "clientOrg": {
        "$ref": "#/components/schemas/ClientOrgDto"
       },
       "claimAmount": {
        "type": "number",
        "description": "Total amount of the claim",
        "example": 50
       },
       "expenseDate": {
        "type": "string",
        "description": "Date of Expense",
        "example": "2024-07-05"
       },
       "merchantName": {
        "type": "string",
        "description": "Name of the merchant related to the claim",
        "example": "CVS Pharmacy, Boston MA"
       },
       "category": {
        "type": "string",
        "description": "The category for the Claim",
        "enum": [
         "OverTheCounter",
         "Wellness",
         "HealthyFood",
         "RentPayment",
         "UtilityPayment",
         "MortgagePayment",
         "Other",
         "FitnessFacility",
         "FitnessClass"
        ],
        "example": "OverTheCounter"
       },
       "description": {
        "type": "string",
        "description": "The short description for the claim",
        "example": "Claim to reimburse the purchase of over the counter medicine"
       },
       "items": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/MemberClaimUpdateDto"
        }
       }
      },
      "required": [
       "category",
       "claimAmount",
       "claimNumber",
       "clientOrg",
       "description",
       "expenseDate",
       "member",
       "merchantName"
      ]
     },
     "PutMemberClaimRequest": {
      "type": "object",
      "properties": {
       "data": {
        "$ref": "#/components/schemas/MemberClaimsData"
       },
       "idempotency": {
        "$ref": "#/components/schemas/Idempotency",
        "description": "Unique identifier that represents the operation",
        "example": "cf82639c-e3b6-4d51-9871-0e452a2b1566"
       }
      },
      "required": [
       "data",
       "idempotency"
      ]
     },
     "ExceptionBaseResponse": {
      "type": "object",
      "properties": {
       "data": {
        "type": "object",
        "description": "null"
       },
       "exceptions": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/ResponseException"
        }
       }
      }
     },
     "ResponseException": {
      "type": "object",
      "properties": {
       "errorCode": {
        "type": "string",
        "description": "The GBL error code that is populated when the exceptionSource is SYSTEM"
       },
       "exceptionSource": {
        "type": "string",
        "description": "Characterizes the type of exception (JSON, SYSTEM, PARAMETER)"
       },
       "exceptionMessage": {
        "type": "string",
        "description": "Additional information about the exception"
       }
      }
     },
     "PersistClaimsResponse": {
      "type": "object",
      "properties": {
       "claimNumber": {
        "type": "string",
        "description": "The claim number",
        "example": "C-1234"
       },
       "clientMemberId": {
        "type": "string",
        "description": "Unique client-side identifier for the member",
        "example": "3f50436491"
       }
      },
      "required": [
       "claimNumber",
       "clientMemberId"
      ]
     }
    },
    "securitySchemes": {
     "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
     }
    }
   }
  }
 },
 {
