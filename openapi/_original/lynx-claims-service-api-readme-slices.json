 {
  "page": "https://docs.lynx-fh.com/reference/memberclaimdetail-1.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "CLAIMS SERVICE API",
    "description": "<Insert page description with key 'api.service.desc' within application.properties>",
    "termsOfService": "http://lynx-fh.com",
    "license": {
     "name": "LynxFH",
     "url": "http://lynx-fh.com"
    },
    "version": "<Insert version with key 'api.service.ver' within application.properties>"
   },
   "servers": [
    {
     "url": "https://sandbox.lynx-fh.co"
    }
   ],
   "security": [
    {
     "bearerAuth": []
    }
   ],
   "paths": {
    "/claims/member/claim/detail": {
     "get": {
      "tags": [
       ""
      ],
      "summary": "Member Claims Detail",
      "description": "Retrieves details of a member claim for a given member\n",
      "operationId": "memberClaimDetail",
      "parameters": [
       {
        "name": "clientOrgName",
        "in": "query",
        "description": "The name of the client organization",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "Health_Plan_ABC_Division"
       },
       {
        "name": "clientMemberId",
        "in": "query",
        "description": "Unique client-side identifier for the member",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "3f50436491"
       },
       {
        "name": "claimNumber",
        "in": "query",
        "description": "The claim number",
        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "C-1234"
       }
      ],
      "responses": {
       "200": {
        "description": "Ok",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/GetClaimDetailResponse"
          }
         }
        }
       },
       "400": {
        "description": "Bad request",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       },
       "401": {
        "description": "Not authorized"
       },
       "404": {
        "description": "Not found",
        "content": {
         "application/json": {
          "schema": {
           "$ref": "#/components/schemas/ExceptionBaseResponse"
          }
         }
        }
       }
      }
     }
    }
   },
   "components": {
    "schemas": {
     "ExceptionBaseResponse": {
      "type": "object",
      "properties": {
       "data": {
        "type": "object",
        "description": "null"
       },
       "exceptions": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/ResponseException"
        }
       }
      }
     },
     "ResponseException": {
      "type": "object",
      "properties": {
       "errorCode": {
        "type": "string",
        "description": "The GBL error code that is populated when the exceptionSource is SYSTEM"
       },
       "exceptionSource": {
        "type": "string",
        "description": "Characterizes the type of exception (JSON, SYSTEM, PARAMETER)"
       },
       "exceptionMessage": {
        "type": "string",
        "description": "Additional information about the exception"
       }
      }
     },
     "MemberBankAccountDto": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "UUID of the Member's external bank account",
        "example": "2aa614ba-5590-4c16-bdd0-3f03964ee274"
       }
      },
      "required": [
       "id"
      ]
     },
     "MemberDto": {
      "type": "object",
      "properties": {
       "clientMemberId": {
        "type": "string",
        "description": "Unique client-side identifier for the member",
        "example": "3f50436491"
       },
       "firstName": {
        "type": "string",
        "description": "First name",
        "example": "John"
       },
       "lastName": {
        "type": "string",
        "description": "Last name",
        "example": "Smith"
       }
      },
      "required": [
       "clientMemberId"
      ]
     },
     "AiAdjudicationResultDTO": {
      "type": "object",
      "properties": {
       "aiValidAmount": {
        "type": "number",
        "description": "Amount that the AI partner validated for the submitted claimdence.",
        "example": 10
       },
       "aiDenyReason": {
        "type": "string",
        "description": "Reason for the denial. Null if not denied.",
        "example": "Silver AI did not recognize any eligible expenses on the receipt/invoice for this claim."
       },
       "aiRecommendation": {
        "type": "string",
        "description": "The AI'd recommendation for the claim.",
        "example": "NeedsReview"
       },
       "confidence": {
        "type": "number"
       },
       "suggestion": {
        "type": "string"
       },
       "flags": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "merchant": {
        "type": "string"
       },
       "expenseDate": {
        "type": "string",
        "format": "date-time"
       },
       "claimAmount": {
        "type": "number"
       },
       "receiptTotal": {
        "type": "number"
       },
       "receiptMerchant": {
        "type": "string"
       },
       "receiptDate": {
        "type": "string",
        "format": "date-time"
       }
      }
     },
     "ClaimDetailItem": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique identifier of the claim detail record",
        "example": "914f6a4b-2da0-4223-86c3-0ec2ffb86865"
       },
       "itemDescription": {
        "type": "string",
        "description": "Text description of the item or service",
        "example": "Tums"
       },
       "amount": {
        "type": "number",
        "description": "Amount for the individual item",
        "example": 40
       }
      }
     },
