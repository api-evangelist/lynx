        "required": true,
        "schema": {
         "type": "string"
        },
        "example": "3f50436491"
       },
       {
        "name": "tagName",
        "in": "query",
        "description": "Indicates the name of the tag to be deleted",
        "required": true,
        "schema": {
         "type": "string"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "Ok",
