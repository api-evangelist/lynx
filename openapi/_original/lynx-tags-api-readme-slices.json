        "schema": {
         "type": "string"
        },
        "example": "Health_Plan_ABC_Division"
       },
       {
        "name": "resourceType",
        "in": "query",
        "description": "Indicates the type of resource for which the tags will be deleted. Possible values are: MEMBER, CLIENT_ORG, MEMBER_TRANSACTION",
        "required": true,
        "schema": {
         "type": "string",
         "enum": [
          "MEMBER",
          "CLIENT_ORG",
          "MEMBER_TRANSACTION",
          "MEMBER_DVH_SERVICE"
